# ============================================================
# memsys 真模型配置模板 —— 复制为 .env 后填入真实值
# 用法：cp .env.example .env （.env 已被 .gitignore 挡住，严禁提交）
# 加载：memsys.llm.load_env() 自动向上查找（cwd/课题3/code/仓库根）
# ============================================================

# ---- GLM（智谱 bigmodel.cn）----
# 密钥获取：https://open.bigmodel.cn → API Keys
GLM_API_KEY=your_glm_api_key_here
# 对话模型（实测选型见 memsys/llm.py GLMClient 注释）：
#   glm-4.5-air  2.4s 质量优（默认，速度/质量/成本平衡）
#   glm-4.5      5.7s 质量最优（旗舰，重要消融用）
#   glm-4-flash  1.8s 最省
GLM_MODEL=glm-4.5-air
# 向量模型（embedding-2，dim=1024，实测 0.5s/次）
GLM_EMBED_MODEL=embedding-2

# ---- DeepSeek（当前主用 LLM；官方无 embedding，向量用 GLM 或 Mock）----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash   # 实测可用：deepseek-flash / deepseek-v4-pro

# ---- 其它 OpenAI 兼容网关（智戎/本地 vLLM，按需启用）----
# LLM_BASE_URL=http://your-gateway/v1
# LLM_API_KEY=your_key
# LLM_MODEL=deepseek-chat
