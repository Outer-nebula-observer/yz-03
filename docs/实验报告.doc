{\pard\ql\li360\f1\fs20 import json, matplotlib.pyplot as plt\f0\fs22\par}
{\pard\ql\li360\f1\fs20 rep = json.load(open("code/\u35838?\u39064?3_\u38271?\u30701?\u26399?\u35760?\u24518?/eval/results/ablation_report.json"))\f0\fs22\par}
{\pard\ql\li360\f1\fs20 g2 = rep["groups"]["G2"]["by_category"]; g3 = rep["groups"]["G3"]["by_category"]\f0\fs22\par}
{\pard\ql\li360\f1\fs20 cats = list(g2.keys()); x = range(len(cats))\f0\fs22\par}
{\pard\ql\li360\f1\fs20 plt.bar([i-0.18 for i in x], [g2[c]["hit@5"] for c in cats], width=0.36, label="G2 \u20165?\u20107?\u23454?\u24211?")\f0\fs22\par}
{\pard\ql\li360\f1\fs20 plt.bar([i+0.18 for i in x], [g3[c]["hit@5"] for c in cats], width=0.36, label="G3 \u21452?\u24211?\u20840?\u24320?")\f0\fs22\par}
{\pard\ql\li360\f1\fs20 plt.axhline(0.357, ls="--", color="gray", label="\u38543?\u26426?\u22522?\u32447?")\f0\fs22\par}
{\pard\ql\li360\f1\fs20 plt.xticks(list(x), cats); plt.ylim(0, 1.1); plt.legend(); plt.show()\f0\fs22\par}
